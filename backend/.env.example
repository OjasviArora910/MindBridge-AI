# Copy to .env and adjust. Never commit real keys.

# SQLite works for local prototyping. Use PostgreSQL for anything shared:
# DATABASE_URL=postgresql+psycopg://mindbridge:mindbridge@localhost:5432/mindbridge
DATABASE_URL=sqlite:///./mindbridge.db

# Used to sign session tokens. MUST be changed outside local development.
SECRET_KEY=change-me-in-real-deployments
TOKEN_TTL_HOURS=72

# LLM provider: "mock" (default, no network), "openai_compatible"
LLM_PROVIDER=Groq
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=20

# Allowed browser origins (comma separated)
CORS_ORIGINS=http://localhost:5173
